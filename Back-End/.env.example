# Supabase — URL project
SUPABASE_URL=https://xxxx.supabase.co
# service_role key (DASHBOARD → Settings → API → service_role, JANGAN di-expose)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Supabase JWT secret (DASHBOARD → Settings → API → JWT secret)
# Hanya dipakai kalau FE memakai Supabase Auth. FE sekarang TIDAK —
# FE punya session HMAC sendiri, jadi yang dipakai di bawah ini.
SUPABASE_JWT_SECRET=super-secret-jwt-token-bahkan-lebih-panjang-nya

# Session HMAC — WAJIB sama persis dengan JWT_SECRET di Front-End/.env.local.
# Tanpa ini, semua request dari FE akan 401.
JWT_SECRET=sama-dengan-front-end